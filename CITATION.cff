        given-names: Rahuman S.
    journal: "Nucleic Acids Research"
    volume: 48
    issue: "D1"
    start: D407
    end: D415
    year: 2020
    doi: "10.1093/nar/gkz1055"
  - type: article
    title: "Graphical requirements for multistationarity in reaction networks and their verification in BioModels"
    authors:
